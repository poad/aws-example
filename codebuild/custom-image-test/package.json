{
  "name": "custom-image-test",
  "version": "0.1.0",
  "bin": "bin/custom-image-test.js",
  "type": "module",
  "scripts": {
    "build": "node_modules/@typescript/native/bin/tsc",
    "watch": "node_modules/@typescript/native/bin/tsc -w",
    "test": "vitest --run",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@eslint/core": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/eslint-plugin": "^1.6.26",
    "aws-cdk": "^2.1135.1",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-awscdk": "^4.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.263.0",
    "constructs": "^10.8.1"
  },
  "jest": {
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
