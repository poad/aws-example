{
  "name": "custom-image-test",
  "version": "0.1.0",
  "bin": "bin/custom-image-test.js",
  "type": "module",
  "scripts": {
    "build": "tsrs",
    "watch": "tsrs -w",
    "test": "vitest --run",
    "cdk": "cdk",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt",
    "format-check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "aws-cdk": "^2.1147.0",
    "jiti": "^2.7.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-plugin-awscdk": "^1.0.4",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.8.1"
  },
  "jest": {
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
