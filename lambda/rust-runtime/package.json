{
  "name": "rust-runtime",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "rust-runtime": "bin/rust-runtime.js"
  },
  "scripts": {
    "build": "tsrs && cd lambda && cargo build",
    "clean": "tsrs --build --clean && cd lambda && cargo clean",
    "watch": "tsrs -w",
    "cdk": "cdk",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "postupdate": "cd lambda && cargo update",
    "format": "oxfmt",
    "format-check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "aws-cdk": "^2.1145.0",
    "dotenv": "^18.0.8",
    "esbuild": "^0.28.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-plugin-awscdk": "^1.0.3",
    "tsx": "^4.23.15",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.273.0",
    "cargo-lambda-cdk": "^0.0.36",
    "constructs": "^10.8.1"
  }
}
