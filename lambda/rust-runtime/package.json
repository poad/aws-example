{
  "name": "rust-runtime",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "rust-runtime": "bin/rust-runtime.js"
  },
  "scripts": {
    "build": "tsc && cd lambda && cargo build",
    "clean": "tsc --build --clean && cd lambda && cargo clean",
    "watch": "tsc -w",
    "cdk": "cdk",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "postupdate": "cd lambda && cargo update",
    "format": "oxfmt",
    "format-check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "aws-cdk": "^2.1144.0",
    "dotenv": "^18.0.5",
    "esbuild": "^0.28.2",
    "jiti": "^2.7.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-plugin-awscdk": "^1.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.272.0",
    "cargo-lambda-cdk": "^0.0.36",
    "constructs": "^10.8.1"
  }
}
