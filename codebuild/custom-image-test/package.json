{
  "name": "custom-image-test",
  "version": "0.1.0",
  "bin": "bin/custom-image-test.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest --run",
    "cdk": "cdk",
    "lint": "oxlint",
    "lint-fix": "oxlint --fix",
    "format": "oxfmt",
    "format-check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "aws-cdk": "^2.1140.0",
    "jiti": "^2.7.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-plugin-awscdk": "^1.0.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.8.1"
  },
  "jest": {
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
