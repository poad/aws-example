{
  "name": "aws-examples",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "oxfmt --check && oxlint && pnpm -r --if-present lint",
    "lint-fix": "oxfmt && oxlint --fix && pnpm -r --if-present lint-fix",
    "format": "pnpm -r --if-present format",
    "format-check": "pnpm -r --if-present format-check"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "npm": "use pnpm please!",
    "yarn": "use pnpm please!"
  },
  "devDependencies": {
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0"
  }
}
