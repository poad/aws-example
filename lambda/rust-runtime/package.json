{
  "name": "rust-runtime",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "rust-runtime": "bin/rust-runtime.js"
  },
  "scripts": {
    "build": "node_modules/@typescript/native/bin/tsc && cd lambda && cargo build",
    "clean": "node_modules/@typescript/native/bin/tsc --build --clean && cd lambda && cargo clean",
    "watch": "node_modules/@typescript/native/bin/tsc -w",
    "cdk": "cdk",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "postupdate": "cd lambda && cargo update"
  },
  "devDependencies": {
    "@eslint/core": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "aws-cdk": "^2.1138.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-awscdk": "^4.4.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-promise": "^7.3.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.266.0",
    "cargo-lambda-cdk": "^0.0.35",
    "constructs": "^10.8.1"
  }
}
